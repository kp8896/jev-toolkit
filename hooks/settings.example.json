{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/jev-toolkit/hooks/guard.mjs\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$HOME/jev-toolkit/hooks/done.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
